# Google Service Account credentials
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----\n"

# Your Google Sheet ID (the long string in the sheet URL)
GOOGLE_SHEET_ID=your_sheet_id_here

# The exact name of the sheet tab
GOOGLE_SHEET_NAME=Movies List

# Vault passcode — protects /add and /update from unauthorized access.
# Set this to a strong alphanumeric passphrase (e.g. "Vault-Horror1984").
# Add this same value to Vercel's environment variables when you deploy.
VAULT_PASSCODE=your-secret-passphrase-here
