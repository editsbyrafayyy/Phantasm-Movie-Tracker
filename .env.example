# .env.example — Copy this to .env.local and fill in real values
# NEVER commit .env.local to git — it is already in .gitignore

# ── Supabase (Required) ────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ── OMDB API (Required for metadata & posters) ─────────────────────────────────
OMDB_API_KEY=your_omdb_key

# ── TMDB API (Required for metadata & posters) ─────────────────────────────────
TMDB_API_KEY=your_tmdb_key

# ── Legacy Google Sheets (Required only for scripts/migrate-from-sheet.ts) ──────
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_NAME="Movies List"

# UUID of the owner account in Supabase (to assign migrated entries to)
OWNER_USER_ID=your-supabase-user-uuid
